<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ILens</AssemblyName>
    <RootNamespace>ILens</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>4</Version>
    <!-- This project lives in Core/. Repo-root-relative paths in the release
         flow below resolve against $(_RepoRoot), not $(MSBuildThisFileDirectory). -->
    <_RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</_RepoRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(_RepoRoot)Build\dist\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.ILSpyX" Version="9.1.0.7988" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>
  <!--
    Release flow: triggered by `dotnet publish -c Release`. Outer call:
      1. Verify clean working tree and that Build/doc/guide.html exists
      2. Read the version we're about to release from csproj; precompute the
         next-cycle version (+1) but do not bump yet
      3. Recursively invoke Publish (passing _ILensInner=true so this target
         skips). The inner build reads the release version straight from csproj.
      3b. Gate: run the end-to-end test suite (Tests/run-test.ps1) against the
         just-published exe; a failing suite fails the publish before staging.
      4. Stage Build/dist: strip junk, copy LICENSE/README/guide.html (the
         guide displays the same version as the just-built binary because csproj
         has not been bumped yet), extract third-party licenses
      5. NOW bump csproj to the next-cycle version and commit
         "Release N published. Preparing N+1."
      6. Redirect outer Publish to a discardable path so it doesn't re-run

    csproj's Version is forward-pointing — it always reflects the version that
    the next publish from this working tree will produce. It advances at the
    end of each publish, not at the start, so /doc and the binary
    always agree on what version they are.

    Path note: this project lives in Core/, so $(MSBuildThisFileDirectory) is the
    Core/ folder. Repo-root paths use $(_RepoRoot); paths under Core/ (such as
    Source\Attribution\) use $(MSBuildThisFileDirectory) directly.
  -->
  <Target Name="_ILensReleaseFlow" BeforeTargets="Publish" Condition="'$(Configuration)' == 'Release' AND '$(_ILensInner)' != 'true'">
    <!-- 1. Working tree must be clean (incl. untracked files) before staging. -->
    <Exec Command="git status --porcelain" IgnoreExitCode="true" ConsoleToMSBuild="true" WorkingDirectory="$(_RepoRoot)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TadisGitStatus" />
    </Exec>
    <Error Condition="'$(_TadisGitStatus)' != ''" Text="Working tree is not clean. Commit or discard changes (including untracked files) before publishing.%0A$(_TadisGitStatus)" />
    <!-- 1b. Public guide must exist; it is generated by /doc and shipped in the ZIP. -->
    <Error Condition="!Exists('$(_RepoRoot)Build\doc\guide.html')" Text="Public documentation is missing at Build\doc\guide.html. Run /doc to regenerate before publishing." />
    <!-- 2. Read the release version from csproj. Precompute the next-cycle
         version (+1) but do not write it yet — bumping happens after staging
         so the bundled guide displays the released version. -->
    <XmlPeek XmlInputPath="$(MSBuildProjectFullPath)" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" ItemName="_TadisReleaseVersionItem" />
    </XmlPeek>
    <PropertyGroup>
      <_TadisReleaseVersion>@(_TadisReleaseVersionItem)</_TadisReleaseVersion>
      <_TadisNextVersion>$([MSBuild]::Add($(_TadisReleaseVersion), 1))</_TadisNextVersion>
    </PropertyGroup>
    <Message Importance="high" Text="[ILens] releasing $(_TadisReleaseVersion); csproj will bump to $(_TadisNextVersion) after staging" />
    <!-- 3. Run the real publish via inner MSBuild call. csproj already holds
         the release version, so no Version override is needed — the inner
         build reads it from the file. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);_ILensInner=true" />
    <!-- 3b. Gate: the end-to-end test suite must pass against the just-published
         single-file exe before the release is staged, bumped, and committed.
         run-test.ps1 is the committed, Claude-skill-independent test workflow;
         a non-zero exit fails the publish here, before any of that happens. -->
    <Exec Command="pwsh -NoProfile -File &quot;$(_RepoRoot)Tests\run-test.ps1&quot; -ILensExe &quot;$(_RepoRoot)Build\dist\ILens.exe&quot;" WorkingDirectory="$(_RepoRoot)" />
    <!-- 4a. Strip incidental files from Distribution -->
    <Delete Files="$(_RepoRoot)Build\dist\$(AssemblyName).pdb" />
    <Delete Files="$(_RepoRoot)Build\dist\$(AssemblyName).xml" />
    <!-- 4b. Copy LICENSE + top-level third-party notice + README + public guide into
         Distribution. The guide's displayed version matches the binary because
         csproj has not been bumped yet. The set of files produced at
         Build/dist/ root must match Core/Source/Attribution/staged-allowlist.txt;
         the post-stage gate (Core/Source/Attribution/check-staged.ps1) reads that
         file and fails publish if anything diverges. -->
    <Copy SourceFiles="$(_RepoRoot)LICENSE" DestinationFolder="$(_RepoRoot)Build\dist\" />
    <Copy SourceFiles="$(_RepoRoot)THIRD-PARTY-NOTICES.txt" DestinationFolder="$(_RepoRoot)Build\dist\" />
    <Copy SourceFiles="$(_RepoRoot)README.md" DestinationFolder="$(_RepoRoot)Build\dist\" />
    <Copy SourceFiles="$(_RepoRoot)Build\doc\guide.html" DestinationFolder="$(_RepoRoot)Build\dist\" />
    <!-- 4c. Stage third-party attribution from Core\Source\Attribution\. Per-source LICENSE/NOTICE
         files plus INDEX.md, all hand-curated and gated by Core\Source\Attribution\check.ps1
         (which the publish skill runs as part of pre-flight). The directory is wiped
         first so stale entries from prior runs cannot survive. -->
    <RemoveDir Directories="$(_RepoRoot)Build\dist\third-party-licenses" />
    <MakeDir Directories="$(_RepoRoot)Build\dist\third-party-licenses" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\dotnet-foundation\LICENSE" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\dotnet-foundation-LICENSE" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\dotnet-runtime\THIRD-PARTY-NOTICES.txt" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\dotnet-runtime-THIRD-PARTY-NOTICES.txt" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\icsharpcode-ilspy\LICENSE" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\icsharpcode-ilspy-LICENSE" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\model-context-protocol\LICENSE" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\model-context-protocol-LICENSE" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\mono-cecil\LICENSE" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\mono-cecil-LICENSE" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\k4os-lz4\LICENSE" DestinationFiles="$(_RepoRoot)Build\dist\third-party-licenses\k4os-lz4-LICENSE" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Source\Attribution\INDEX.md" DestinationFolder="$(_RepoRoot)Build\dist\third-party-licenses\" />
    <!-- 5. NOW bump csproj for the next release cycle and commit. The message
         records what was just released and what csproj now holds. -->
    <XmlPoke XmlInputPath="$(MSBuildProjectFullPath)" Query="/Project/PropertyGroup/Version" Value="$(_TadisNextVersion)" />
    <Message Importance="high" Text="[ILens] bumped csproj $(_TadisReleaseVersion) -&gt; $(_TadisNextVersion) for next cycle" />
    <Exec Command="git add &quot;$(MSBuildProjectFullPath)&quot;" WorkingDirectory="$(_RepoRoot)" />
    <Exec Command="git commit -q -m &quot;Release $(_TadisReleaseVersion) published. Preparing $(_TadisNextVersion).&quot;" WorkingDirectory="$(_RepoRoot)" />
    <Message Importance="high" Text="[ILens] committed: release $(_TadisReleaseVersion); csproj now at $(_TadisNextVersion)" />
    <!-- 6. Outer Publish would otherwise re-run with its cached project model
         and write another copy of the release binary to Distribution. Redirect
         it to a throwaway path so the staged Distribution stays intact. -->
    <PropertyGroup>
      <PublishDir>$(_RepoRoot)Build\_OuterPublishDiscard\</PublishDir>
    </PropertyGroup>
  </Target>
</Project>