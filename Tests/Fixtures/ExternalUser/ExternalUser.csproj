<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only fixture: uses ExternalLib's types in every shape analyze answers
    for a type from another assembly. Private=false keeps ExternalLib.dll from
    being copied beside it, so the reference resolves only for a server given
    the folder ExternalLib.dll sits in as an allow-root. Not consumed by Tests'
    source code;
    only its compiled output is inspected by the ILens server during the e2e
    suite.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Fields that exist only to be referenced. -->
    <NoWarn>$(NoWarn);CS0414;CS0169;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExternalLib\ExternalLib.csproj" Private="false" />
  </ItemGroup>

</Project>
