<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Fixtures/ holds standalone projects (e.g. HarmonyMod) that produce DLLs
       Tests inspects, not source compiled into the test assembly itself.
       Without this exclusion, Tests' default glob would compile their .cs
       files and Tests would also need their PackageReferences. -->
  <ItemGroup>
    <Compile Remove="Fixtures\**" />
    <None Remove="Fixtures\**" />
    <EmbeddedResource Remove="Fixtures\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The MCP SDK client (drives the ILens server over stdio) and
       ICSharpCode.Decompiler (referenced only so its assembly lands in the
       test output as the e2e inspection target — the tests point ILens at it,
       they do not call it directly). -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
  </ItemGroup>

  <!-- HarmonyMod fixture: a tiny Harmony-patching assembly compiled from
       Fixtures/HarmonyMod/, used as the inspection target for the
       find_harmony_dependencies tests. HarmonyMod2 is the RVA-shifted twin
       the comparison tests use to check that identical IL at different file
       positions compares equal (same source, extra Padding class declared
       earlier). HarmonyMod3 compiles against Harmony 3.0's release candidate
       3.0.0-rc.4 and holds the lookups only that version has.
       ReferenceOutputAssembly=false keeps their types out of Tests'
       compilation — we only want the DLLs to land in the test output bin. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\HarmonyMod\HarmonyMod.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="Fixtures\HarmonyMod2\HarmonyMod2.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="Fixtures\HarmonyMod3\HarmonyMod3.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CallShapes fixture: the same uses inside lambdas, local functions,
       iterators and async methods, the shapes the compiler moves into generated
       methods, and the argument shapes call_sites resolves. Used by the
       analyze tests. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\CallShapes\CallShapes.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- BaseShift fixture and its twin BaseShift2: one source compiled twice, the
       second time with SHIFTED defined, so that a few types change their base
       class or interface, one changes only inside accessor bodies, one has every
       compiler-generated name shifted, one changes only inside generated code,
       an interface gains three members, one of two overloads that differ only
       in a keyword changes its body, and nothing else differs. Used by the
       compare tests. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\BaseShift\BaseShift.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="Fixtures\BaseShift2\BaseShift2.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ExternalUser fixture: uses a type of ExternalLib in every shape analyze
       answers for a type from another assembly. ExternalLib.dll lands only in
       References, so for the shared server its references stay unresolved. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\ExternalUser\ExternalUser.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- References: the assemblies the fixtures reference, ExternalLib for
       ExternalUser and HarmonyLib for HarmonyMod, one level below the test
       output. The shared server searches only the top of an allow-root, so it
       does not find them; the reference tests give a second server this folder
       as an allow-root of its own. Lib.Harmony.Ref is the reference assembly
       HarmonyMod's Lib.Harmony compiles against, so its version follows that
       one. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\ExternalLib\ExternalLib.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest"
                      Link="References\ExternalLib.dll" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3"
                      GeneratePathProperty="true"
                      ExcludeAssets="all" />
    <Content Include="$(PkgLib_Harmony_Ref)\ref\netstandard2.0\0Harmony.dll"
             Link="References\0Harmony.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ExplicitMembers fixture: members implementing an interface member
       explicitly, in each shape name resolution treats differently. Used by the
       tests that resolve a member by the plain name of the interface member. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\ExplicitMembers\ExplicitMembers.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FieldAccess fixture: fields used through the address the compiler takes,
       in every way the read_by and assigned_by answers tell apart. Used by the
       field-access tests. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\FieldAccess\FieldAccess.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SearchText fixture: one known line in each place search_code has to find
       or leave out, each under the member it belongs to. Used by the
       search_code tests. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\SearchText\SearchText.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- InterfaceShapes fixture: an interface with a member of every shape C#
       allows in one, and overrides that return a more specific type than the
       member they override, built for .NET 10, since the compiler refuses a
       default implementation, a static abstract member and such an override
       for netstandard2.0. Used by the tests on how list_members writes an
       interface's members and by the tests on such an override. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\InterfaceShapes\InterfaceShapes.csproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- VbModules fixture, in Visual Basic: a module whose extension methods the
       compiler writes into a sealed class that is not static, and a class with an
       event and an auto-implemented property, for which the compiler adds fields.
       Used by the tests on finding an extension method from the type it extends
       and by those on the fields a compiler adds. -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\VbModules\VbModules.vbproj"
                      ReferenceOutputAssembly="false"
                      Private="true"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>